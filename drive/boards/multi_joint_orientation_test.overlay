/ {
	chosen {
		zephyr,console = &usart2;
		zephyr,shell-uart = &usart2;
	};
};

&usart2 {
	pinctrl-0 = <&usart2_tx_pd5 &usart2_rx_pd6>;
	pinctrl-names = "default";
	current-speed = <57600>;
	status = "okay";
};

/* Confirmed imu_mag_test bus and address allocation. */
&i2c1 {
	pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb9>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	first_link_imu: mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		status = "okay";
	};

	second_link_imu: mpu6050@69 {
		compatible = "invensense,mpu6050";
		reg = <0x69>;
		status = "okay";
	};

	turntable_mag: lsm9ds1_mag@1c {
		compatible = "st,lsm9ds1_mag";
		reg = <0x1c>;
		status = "okay";
	};
};

&i2c4 {
	pinctrl-0 = <&i2c4_scl_pf14 &i2c4_sda_pf15>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	end_effector_imu: mpu6050@68 {
		compatible = "invensense,mpu6050";
		reg = <0x68>;
		status = "okay";
	};

	base_reference_mag: lsm9ds1_mag@1c {
		compatible = "st,lsm9ds1_mag";
		reg = <0x1c>;
		status = "okay";
	};

	end_effector_mag: lsm9ds1_mag@1e {
		compatible = "st,lsm9ds1_mag";
		reg = <0x1e>;
		status = "okay";
	};
};
